# Copia este archivo como .env y ajusta los valores.

# Django
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
# En desarrollo (config.settings.dev) se aceptan todas las IPs de la red local.
# ALLOWED_HOSTS=midominio.edu.pe   (obligatorio en producción)
# JWT_SIGNING_KEY=  (vacío = usa SECRET_KEY)

# Base de datos: mysql (XAMPP/Laragon) o sqlite (prueba rápida sin MySQL)
DB_ENGINE=mysql
DB_NAME=asistencia_escolar
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Origen web de Expo (solo si usas la app en el navegador)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Producción
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO
